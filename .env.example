# .env.example — Copy to .env and fill in your local values.
# Used by `stemmy dev train` and `stemmy dev eval` when --data-root is not
# passed as a flag or exported in the shell environment.

TRAIN_DATA_ROOT="/path/to/musdb18hq"

# Optional: W&B configuration (can also be set via shell environment)
# WANDB_ENV="dev"              # "dev" or "production"
# WANDB_API_KEY=""
# NO_WANDB="1"                 # Set to "1" to disable W&B logging
