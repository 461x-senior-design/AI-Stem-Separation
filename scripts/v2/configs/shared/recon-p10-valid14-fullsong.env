# Winning full-song validation recipe from
# run-510-fixed-valid14-fullsong-v2_20260510-182031_bc9fe83.
#
# Best checkpoint in that run:
#   epoch=90 mean_sisdr=-3.409884 on 15 MUSDB test tracks, MAX_SECONDS=0.
# Keep secrets out of shared configs; WANDB_API_KEY must come from the user env.

RUNS_BASE="/nfs/hpc/share/${ONID}/stemmy/runs-recon-p10"
DATA_ROOT="/nfs/hpc/share/stemmy/data/musdb18hq"

EPOCHS="100"
SAVE_EVERY_EPOCHS="10"
LR="1e-4"
LR_PATIENCE="10"
WEIGHT_DECAY="1e-6"
BASE_CHANNELS="64"
TIME_FRAMES="512"
CHUNK_FRAMES="512"
BATCH_SIZE=""
NUM_WORKERS_MAX="24"

SPLIT_SOURCE="musdb_builtin"
WAVEFORM_NORM="peak"
SPECTROGRAM_NORM="freq_minmax"
AMP="1"
DEVICE="cuda"

N_EVAL_TRACKS="15"
MAX_SECONDS="0"
EVAL_EVERY_N_CKPTS="1"
EVAL_WATCH_POLL_SECONDS="60"
EVAL_PROGRESS="1"
EVAL_PRINT_METRICS="0"
EVAL_FLUSH_EVERY="1"
EVAL_FSYNC_EVERY="0"
EVAL_PRINT_EVERY_TRACKS="1"

WANDB_ENV="production"
WANDB_MODE="online"
WANDB_DIR="wandb"
WANDB_RUN_NAME="recon-p10-valid14-fullsong"

SEPARATE_OUT_BASE="runs-recon-p10/separated_cli"
