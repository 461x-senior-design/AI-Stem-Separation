# Confirmation recipe anchored on the overnight-ablation winner.
#
# Overnight winner cell (15-track eval, MUSDB test):
#   recon-p10-valid14-fullsong + LR=2e-4 + BATCH_SIZE=12 + SPLIT_SOURCE=musdb_builtin
#   best_epoch=90 mean_sisdr=-3.265 (pair_01 / runs qvplsk5y eval, 51kcfsrz train)
#
# This config locks the non-LR knobs to the winning cell and bumps
#   - N_EVAL_TRACKS 15 -> 50  (full MUSDB test set; pins the ranking)
#   - SAVE_EVERY_EPOCHS 10 -> 5  (finer-grained peak detection)
#   - EVAL_EVERY_N_CKPTS 1 -> 2  (keeps eval cost manageable on 50 tracks)
#   - EPOCHS 100 -> 300  (verify the ep~90 peak isn't truncated)
#
# Companion matrix sweeps LR over {1.5e-4, 2e-4, 3e-4} to confirm the LR ranking.
# Secrets stay out of shared configs; WANDB_API_KEY must come from the user env.

RUNS_BASE="/nfs/hpc/share/${ONID}/stemmy/runs-recon-p10"
DATA_ROOT="/nfs/hpc/share/stemmy/data/musdb18hq"

EPOCHS="300"
SAVE_EVERY_EPOCHS="5"
LR="2e-4"
LR_PATIENCE="10"
WEIGHT_DECAY="1e-6"
BASE_CHANNELS="64"
TIME_FRAMES="512"
CHUNK_FRAMES="512"
BATCH_SIZE="12"
NUM_WORKERS_MAX="24"

SPLIT_SOURCE="musdb_builtin"
WAVEFORM_NORM="peak"
SPECTROGRAM_NORM="freq_minmax"
AMP="1"
DEVICE="cuda"

N_EVAL_TRACKS="50"
MAX_SECONDS="0"
EVAL_EVERY_N_CKPTS="2"
EVAL_WATCH_POLL_SECONDS="60"
EVAL_PROGRESS="1"
EVAL_PRINT_METRICS="0"
EVAL_FLUSH_EVERY="1"
EVAL_FSYNC_EVERY="0"
EVAL_PRINT_EVERY_TRACKS="1"

WANDB_ENV="production"
WANDB_MODE="online"
WANDB_DIR="wandb"
WANDB_RUN_NAME="confirm-winner-fullsong"

SEPARATE_OUT_BASE="runs-recon-p10/separated_cli"
