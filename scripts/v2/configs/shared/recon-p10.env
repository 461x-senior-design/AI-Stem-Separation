# Experiment: LR patience 10, separate runs-recon-p10 output dir.
# Overrides scripts/defaults.env. WANDB_API_KEY must come from the environment
# or from scripts/configs/<user>/defaults.env — do not add it here.

RUNS_BASE="/nfs/hpc/share/${ONID}/stemmy/runs-recon-p10"

EPOCHS="30"
LR_PATIENCE="10"
CHUNK_FRAMES="512"   # match TIME_FRAMES to avoid train/eval crop-length mismatch

WANDB_RUN_NAME="recon-p10"
SEPARATE_OUT_BASE="runs-recon-p10/separated_cli"
