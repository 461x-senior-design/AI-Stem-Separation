# scripts/defaults.env — project-wide baseline.
#
# Every knob the stemmy CLI and _train_inner.sh consume is declared here with
# its default. Named configs under scripts/configs/ only need to contain
# overrides. CLI KEY=VALUE overrides win over both.
#
# Secrets (WANDB_API_KEY, etc.) must come from the environment or from a
# per-user gitignored config under scripts/configs/<user>/. Do not put them
# here.

# ---------- identity ----------
ONID="${ONID:-${USER:-unknown}}"

# ---------- paths ----------
DATA_ROOT="${DATA_ROOT:-/nfs/stak/users/${ONID}/stemmy/data/musdb18hq}"
RUNS_BASE="${RUNS_BASE:-/nfs/hpc/share/${ONID}/stemmy/runs}"

# ---------- training ----------
EPOCHS="30"
LR="1e-4"
WEIGHT_DECAY="1e-6"
TIME_FRAMES="512"         # 256 or 512
MAX_TRACKS="0"            # 0 = use full train set
BASE_CHANNELS="64"
LR_FACTOR="0.5"
LR_PATIENCE="10"          # halve LR after this many flat epochs
MIN_LR="1e-6"
SAVE_EVERY_EPOCHS="2"
WAVEFORM_NORM="peak"      # peak|rms|none
SPECTROGRAM_NORM="freq_minmax"  # freq_minmax|none
AMP="1"                   # 0|1 — mixed precision
DEVICE="cuda"             # cpu|cuda|cuda:N

# ---------- batch/worker autosize ----------
BATCH_SIZE=""             # empty = probe; set int to force
BATCH_SIZE_DEFAULT="4"
NUM_WORKERS_MAX="24"

# ---------- eval ----------
N_EVAL_TRACKS="15"
MAX_SECONDS="20"
EVAL_EVERY_N_CKPTS="2"
CHUNK_FRAMES="512"        # match TIME_FRAMES to avoid train/eval mismatch
EVAL_WATCH_POLL_SECONDS="60"
EVAL_PROGRESS="1"
EVAL_PRINT_METRICS="0"
EVAL_FLUSH_EVERY="1"
EVAL_FSYNC_EVERY="0"
EVAL_PRINT_EVERY_TRACKS="1"

# ---------- resume ----------
# RESUME        = explicit checkpoint path
# RESUME_LATEST = 1 to resolve latest_best_<partition>.pth (best by SI-SDR)
# RESUME_LAST   = 1 to resolve latest_last_<partition>.pth (highest epoch)
RESUME=""
RESUME_LATEST="0"
RESUME_LAST="0"

# ---------- LR backoff on OOM/NaN ----------
LR_BACKOFF="0"
LR_BACKOFF_FACTOR="0.5"
LR_BACKOFF_MAX_TRIES="3"

# ---------- wandb ----------
# WANDB_API_KEY intentionally not set here — see scripts/configs/README.md.
WANDB_ENV="production"
WANDB_RUN_NAME=""         # defaults to the stemmy run name if empty
WANDB_DIR=""

# ---------- inference helpers ----------
INPUT_REL="test/Angels In Amplifiers - I'm Alright/mixture.wav"
SEPARATE_OUT_BASE=""
